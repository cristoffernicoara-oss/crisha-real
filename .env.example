# Resend (server): app/api/contact kräver RESEND_API_KEY. Saknas RESEND_FROM används onboarding@resend.dev i route.ts.
# Formulär-inkorg: konstant MAIL_TO_INBOX i route.ts (inte samma sak som CONTACT.email på sajten).
# https://resend.com
RESEND_API_KEY=
# Valfritt. Ex.: "Crisha <kontakt@crisha.se>" när domän är verifierad. Tom = onboarding@resend.dev i koden.
RESEND_FROM=
