# Resend (server): app/api/contact kräver RESEND_API_KEY.
# RESEND_FROM=info@crisha.se i .env/Vercel dokumenterar samma adress som verifierad avsändare i Resend (From i koden är alltid Crisha Marketing &lt;info@crisha.se&gt;).
# Verifiera crisha.se och avsändaren i Resend Dashboard innan utskick till produktion fungerar.
# Formulär-inkorg: konstant MAIL_TO_INBOX i route.ts.
# https://resend.com
RESEND_API_KEY=
RESEND_FROM=info@crisha.se

# Canonical site URL for sitemap.xml, robots.txt, Open Graph and JSON-LD.
# Set the same value in Vercel → Project → Settings → Environment Variables → Production.
NEXT_PUBLIC_SITE_URL=https://www.crisha.se
