# Azure Entra ID / Microsoft Graph
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
# interactive = lokal browser-login | client_credentials = moln (Railway) utan dator
GRAPH_AUTH_MODE=interactive
OUTLOOK_USER=info@crisha.se

# Vart eskaleringar och tekniska fel skickas
OPERATOR_EMAIL=info@crisha.se
CALENDLY_URL=https://calendly.com/din-lank

# AI
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Outreach
OUTREACH_ENABLED=true
OUTREACH_MAX_PER_DAY=30
QUARANTINE_MONTHS=7
TIMEZONE=Europe/Stockholm
DRY_RUN=true

# Blog
BLOG_ENABLED=true
PUBLISH_MODE=draft
SITE_URL=https://www.crisha.se
# CONTENT_BLOG_DIR=  (default: ../content/blog)

BOUNCE_ALERT_THRESHOLD=5
INBOX_POLL_MS=300000
LOG_LEVEL=info
